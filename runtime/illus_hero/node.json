  ],
  "measures": [
   "palette",
   "line_w_pct",
   "edge_grey",
   "texture_all",
   "ground_cover",
   "tones",
   "hero_bbox_area_pct"
  ],
  "note": "the six measures of measure.py (palette, line width, edge transition, texture, white, hatch spread) are all written; hero_bbox_area_pct is the share of the frame"
 },
 "stories": {
  "doc": "The opening picture follows the page's story, not its table: the caller names the lead finding's angle (findings.py ANGLES, the page's first titled section) as `lead`, and the scene it maps to here is drawn: its hero (placed, sized and framed by the scene), its own layout of the request's tags (a tag the scene has no slot for is left out), and the parts it always places. An angle with no scene, a scene whose tags or hero the request lacks, or no lead keeps the panorama (heroes + slots). Same input, same picture: nothing is random or read from words.",
  "angles": {
   "path": "road",
   "need": "steps",
   "rank": "lineup",
   "spread": "lineup",
   "ends": "pair",
   "members": "atlas",
   "map": "atlas",
   "chain": "sequence"
  }
 },
