   "default": true,
   "note": "one pale grey wisp from the first coal chimney, the only grey block"
  },
  "seed": {
   "default": 21
  }
 },
 "input": {
  "schema": {
   "tags": [
    "subset of: wind, solar, hydro, coal, gas, grid"
   ],
   "ground": "name or colours",
   "accent": "hex",
   "composition": "any of the composition_knobs",
   "parts": "optional {part_id: {knob: value}} overrides, clamped to the ranges above"
  },
  "render": {
   "w": 2880,
   "h": 1120,
   "view_w": 1440,
   "view_h": 560
  }
 },
 "output": {
  "files": [
   "hero.svg (1440x560 viewBox, paper and paint grain embedded as raster, ink and paint planes vector)",
   "hero.png (2880x1120, Chrome screenshot of the svg)",
   "result.json"
  ],
  "measures": [
   "palette",
   "line_w_pct",
   "edge_grey",
   "texture_all",
   "ground_cover",
   "tones",
   "hero_bbox_area_pct"
  ],
  "note": "the six measures of measure.py (palette, line width, edge transition, texture, white, hatch spread) are all written; hero_bbox_area_pct is the share of the frame"
 }
