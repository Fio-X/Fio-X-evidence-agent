,
  "notes": {
   "binding": "external",
   "geometry": "leaf",
   "runner": "leaves_py/scmp.py",
   "declares_by_recipe": {
    "scmp": {
     "selects": [
      {
       "id": "focus",
       "kind": "given",
       "given": "$picks.focus"
      }
     ],
     "binds": {
      "focus": "select:focus"
     },
     "tree_only": [
      "focus"
     ],
     "items_for": "select:top",
     "candidates": [
      {
       "when": [{"if": "row_above", "table": "$shape.main", "filter": {"$shape.place": "{code}", "geo": "$shape.hub"}, "time": "$picks.t0", "than": 0}],
       "code": "{code}",
       "a": "{code_lc}{y0}",
       "b": "{code_lc}{y1}",
       "ch": "{code_lc}_ch",
       "share": "{code_lc}{y1}_share"
      },
      {
       "code": "{code}",
       "a": "{code_lc}{y0}",
       "b": "{code_lc}{y1}",
       "ch": null,
       "share": "{code_lc}{y1}_share"
      }
     ],
     "leaf": {
      "key": "notes",
      "items_as": "notes",
      "items": {
       "code": "note.code",
       "a": "note.a",
       "b": "note.b",
       "ch": "note.ch",
       "share": "note.share",
       "f": "f"
      },
      "items_after": [
       {"hub": true, "a": "tot{y0}", "b": "tot{y1}", "ch": "tot_ch"}
      ],
      "fact_fields": [
       "a",
       "b",
       "ch",
       "share"
      ]
     }
    }
   },
   "items": {
    "for_each": "items_for",
    "fields": {
     "note": {
      "kind": "first_holding"
     },
     "f": {
      "kind": "code_is",
      "ref": "binds.focus"
     }
    }
   }
  }
,
  "stacked100": {
   "binding": "external",
   "geometry": "leaf",
   "runner": "leaves_py/stacked100.py",
   "declares": {
    "shape": "parts_of_whole",
    "needs": {"path": "composition", "words": "stacked100: main {shape.main} holds no composition"},
    "stop_prefix": "not this shape: ",
    "target": {"min": ["$top", {"len": "$shape.countries"}]},
    "selects": [
     {"id": "countries", "kind": "given", "given": "$shape.countries"},
     {"id": "outside", "kind": "given", "given": "$outside"},
     {"id": "groups", "kind": "given", "given": "$composition.groups_map"},
     {
      "id": "candidates",
      "kind": "rank",
      "over": {"table": "$shape.main", "by": "$shape.place", "filter": {"$composition.dim": "$composition.total"}, "time": "$shape.year"},
      "key": "value",
      "order": "desc",
      "only": "select:countries",
      "tie": {"by": "code", "outcome": "order"},
      "one_row_per_code": true
     },
     {
      "id": "bars",
      "kind": "drop_replace",
      "from": "candidates",
      "target": "$target",
      "replace": "next_in_order",
      "check": {
       "sum_within": {
        "table": "$shape.main",
        "time": "$shape.year",
        "place": "$shape.place",
        "dim": "$composition.dim",
        "parts": "select:groups",
        "total": "$composition.total",
        "tol": {"knob": "stacked100.tol", "value": "$knob.stacked100.tol"}
       }
      }
     },
     {"id": "zero", "kind": "zero_parts", "bars": "bars", "table": "$shape.main", "time": "$shape.year", "place": "$shape.place", "dim": "$composition.dim", "parts": "select:groups"},
     {"id": "empty", "kind": "empty_parts", "bars": "bars"},
     {"id": "read", "kind": "set_op", "op": "union", "a": "bars", "b": "bars#dropped"},
     {"id": "unread", "kind": "set_op", "op": "minus", "a": "candidates", "b": "read"},
     {"id": "others", "kind": "set_op", "op": "union", "a": "unread", "b": "outside"}
    ],
    "stops": [
     {"rule": "number_in_rows_read", "select": "bars", "words": "stacked100: the row {src_json} holds no number"},
     {
      "rule": "max_dropped",
      "select": "bars",
      "num": 1,
      "den": 4,
      "words": "stacked100: {dropped_n} of the {target} places ({dropped_codes}) have groups that do not add up to their {composition.total} at {shape.year} within {tol} of it, more than a quarter"
     },
     {"rule": "fill_after_drop", "select": "bars", "words": "stacked100: {drawn_n} places add up at {shape.year} after {dropped_n} left out, short of {target}, and the sum inputs hold no next place"}
    ],
    "items": "bars",
    "parts": "groups",
    "zero": "zero",
    "empty": "empty",
    "dropped": "bars#dropped",
    "others": "others",
    "facts": {
     "item_total": {"key": "total.{item}", "q": {"op": "value", "table": "$shape.main", "filter": {"$shape.place": "{item}", "$composition.dim": "$composition.total"}, "time": "$shape.year", "fmt": "$shape.fmt"}},
     "part_sum": {"key": "sum.{part}.{item}", "q": {"op": "value", "table": "$shape.main", "filter": {"$shape.place": "{item}", "$composition.dim": "{part_codes}"}, "time": "$shape.year", "fmt": "$shape.fmt"}},
     "part_share": {"key": "share.{part}.{item}", "q": {"op": "share", "a": "sum.{part}.{item}", "b": "total.{item}"}},
     "items_n": {"key": "comp_bars", "q": {"op": "n", "by": "$shape.place", "table": "$shape.main", "filter": {"$shape.place": "{items}", "$composition.dim": "$composition.total"}, "time": "$shape.year", "fmt": "n"}},
     "dropped_sum": {"key": "drop_sum.{item}", "q": {"op": "value", "table": "$shape.main", "filter": {"$shape.place": "{item}", "$composition.dim": "{all_codes}"}, "time": "$shape.year", "fmt": "$shape.fmt"}},
     "dropped_gap": {"key": "gap.{item}", "q": {"op": "minus", "a": "{larger}", "b": "{smaller}", "fmt": "comp_gap"}},
     "zero_n": {"key": "zero.{part}", "q": {"op": "zeros", "table": "$shape.main", "filter": {"$shape.place": "{items}", "$composition.dim": "{part_codes}"}, "time": "$shape.year", "fmt": "n"}},
     "others_n": {"key": "comp_others", "q": {"op": "n", "by": "$shape.place", "table": "$shape.main", "filter": {"$shape.place": "{items}", "$composition.dim": "$composition.total"}, "time": "$shape.year", "fmt": "n"}}
    },
    "fmts": {
     "$shape.fmt": {"scale": 1, "dec": 0, "suffix": "$shape.suffix"},
     "comp_gap": {
      "when": "dropped",
      "scale": 1,
      "suffix": "$shape.suffix",
      "dec_rule": {"rule": "held_decimals_read", "rows": ["dropped_totals", "sum_rows"], "max": {"const": "COMPOSITION_GAP_DEC", "value": 3}}
     }
    },
    "leaf": {
     "head": {"bar_kind": "place", "part_kind": "siec_group"},
     "total_text": "fact:total.{item}.n",
     "share_text": "fact:share.{part}.{item}",
     "total_head": {"name": "$composition.dim", "code": "$composition.total"},
     "title": {"fixed": "frames:composition", "frame": "Composition"},
     "unit": {"fixed": "unit_short_zh:{shape.unit}", "text": "$short"},
     "others_head": [{"w": "其余 "}, {"src": "fact:comp_others.n"}, {"w": " 个国家（按合计由大到小）："}]
    },
    "lines": [
     {"each": "once", "segs": [{"w": "图中为合计最大的 "}, {"src": "fact:comp_bars.n"}, {"w": " 个国家，自上而下由大到小"}]},
     {"each": "dropped", "segs": [{"place_name": "{item}"}, {"w": "：各组之和与合计相差 "}, {"src": "fact:gap.{item}"}, {"w": "，未列入图中，由合计次大的国家递补"}]},
     {"each": "zero_part", "segs": [{"name": "siec_group", "code": "{part}"}, {"w": "为零的国家："}, {"list_places": "{items}", "sep": "、"}]}
    ],
    "names": [
     {"kind": "$composition.dim", "codes": ["$composition.total"]},
     {"kind": "siec_group", "codes": "{parts}", "labels": true}
    ],
    "hero_data": {"table": "$shape.main", "year": "$shape.year"},
    "unit_drawn": true,
    "record": {"bars": "items", "dropped": "dropped", "others": "others", "zero": "zero_declared"}
   }
  }
 }
}
