       {"when": [{"if": "count_at_least", "select": "ranked", "n": 3}, {"if": "sign", "fact": "chg.{code}", "is": "zero"}, {"if": "prints_nonzero", "fact": "vs_lo", "fmt": "$fmt.change"}, {"if": "width_at_most", "text": ["{name}", " ", {"word": "column.note.flat"}, {"word": "column.note.vs_prev"}], "size": 16, "max": 280}], "text": [{"word": "column.note.flat"}, {"word": "column.note.vs_prev"}], "value_text": "fact:vs_lo", "facts": {"vs_lo_a0": {"op": "last", "table": "$shape.main", "filter": {"$shape.place": "select:prev_last"}, "from": "$picks.t0", "to": "$picks.t0", "fmt": "$shape.fmt"}, "vs_lo_a1": {"op": "last", "table": "$shape.main", "filter": {"$shape.place": "select:prev_last"}, "from": "$shape.year", "to": "$shape.year", "fmt": "$shape.fmt"}, "vs_lo_a": {"op": "minus", "a": "vs_lo_a1", "b": "vs_lo_a0", "fmt": "$fmt.change"}, "vs_lo_b0": {"op": "last", "table": "$shape.main", "filter": {"$shape.place": "{code}"}, "from": "$picks.t0", "to": "$picks.t0", "fmt": "$shape.fmt"}, "vs_lo_b1": {"op": "last", "table": "$shape.main", "filter": {"$shape.place": "{code}"}, "from": "$shape.year", "to": "$shape.year", "fmt": "$shape.fmt"}, "vs_lo_b": {"op": "minus", "a": "vs_lo_b1", "b": "vs_lo_b0", "fmt": "$fmt.change"}, "vs_lo": {"op": "minus", "a": "vs_lo_a", "b": "vs_lo_b", "fmt": "$fmt.change"}}},
