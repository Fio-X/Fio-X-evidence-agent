# Local model/provider environment template.
# Copy to .env (ignored by git) or point NEWSROOM_ENV_FILE at an external file.
# Never commit real API keys.

# Pi runtime selection used by `news investigate`.
# Fill these with the provider/model pair that is actually valid for your account.
NEWSROOM_PI_PROVIDER=
NEWSROOM_PI_MODEL=
NEWSROOM_PI_THINKING=high

# Live qualification wrappers. When running scripts directly, keep these aligned
# with the Pi provider/model under qualification.
NEWSROOM_PROVIDER=
NEWSROOM_MODEL=

# OpenAI or an OpenAI-compatible relay.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Verified local relay input shape used by this project:
# NEWSROOM_PI_PROVIDER=openai
# NEWSROOM_PI_MODEL=claude-sonnet-4-6
# OPENAI_BASE_URL=https://dragoncode.codes
# OPENAI_API_KEY=<secret>
#
# The CLI recognizes dragoncode.codes and normalizes the child Pi transport as
# required by the pinned runtime while preserving this local input convention.

# Anthropic.
ANTHROPIC_API_KEY=

# DeepSeek.
DEEPSEEK_API_KEY=

# Kimi / Moonshot. Custom Pi models in config/pi-models.example.json use
# KIMI_API_KEY; MOONSHOT_API_KEY is retained for provider-native compatibility.
KIMI_API_KEY=
MOONSHOT_API_KEY=

# Z.AI / Zhipu aliases used by supported runtime paths.
ZAI_API_KEY=
ZHIPUAI_API_KEY=

# Optional explicit DragonCode custom-provider route.
DRAGONCODE_API_KEY=
DRAGONCODE_BASE_URL=
DRAGONCODE_MODEL=

# Generic direct-client overrides used by chat/investigate-v2 paths.
NEWSROOM_API_KEY=
NEWSROOM_BASE_URL=
