# Local model/provider environment template.
# Copy to .env (ignored by git) or point NEWSROOM_ENV_FILE at an external file.
# Never commit real API keys.

# Pi runtime selection used by `news investigate`.
# Fill these with the provider/model pair that is actually valid for your account.
NEWSROOM_PI_PROVIDER=
NEWSROOM_PI_MODEL=
# Optional reasoning level (minimal, low, medium, high). Unset, requests carry no thinking; set, every model request
# reserves that thinking budget and spends more tokens.
# NEWSROOM_PI_THINKING=medium

# Live qualification wrappers. When running scripts directly, keep these aligned
# with the Pi provider/model under qualification.
NEWSROOM_PROVIDER=
NEWSROOM_MODEL=

# OpenAI or an OpenAI-compatible relay.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Verified local relay input shape used by this project:
# NEWSROOM_PI_PROVIDER=openai
# NEWSROOM_PI_MODEL=claude-sonnet-4-6
# OPENAI_BASE_URL=https://relay.example.invalid
# OPENAI_API_KEY=<secret>
#
# For the project's own relay address the CLI maps this input to the relay provider
# (Anthropic Messages route) as the pinned runtime requires, while preserving this
# local input convention. Any other address keeps the provider as set.

# Anthropic.
ANTHROPIC_API_KEY=

# DeepSeek.
DEEPSEEK_API_KEY=

# Kimi / Moonshot. Custom Pi models in config/pi-models.example.json use
# KIMI_API_KEY; MOONSHOT_API_KEY is retained for provider-native compatibility.
KIMI_API_KEY=
MOONSHOT_API_KEY=

# Z.AI / Zhipu aliases used by supported runtime paths.
ZAI_API_KEY=
ZHIPUAI_API_KEY=

# Optional explicit relay route (an OpenAI-compatible relay on the Anthropic Messages route).
NEWSROOM_RELAY_API_KEY=
NEWSROOM_RELAY_BASE_URL=
NEWSROOM_RELAY_MODEL=

# Generic provider key/address overrides: read by the agent child config (src/pi.rs) when no
# provider-specific variable applies. (`news chat`, which used them for a direct call, was removed.)
NEWSROOM_API_KEY=
NEWSROOM_BASE_URL=
