{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-data-newsroom:schema:evidence-ledger:0.1.0",
  "title": "Agentic Data Newsroom Evidence Ledger v0.1",
  "type": "object",
  "required": ["schema_version", "ledger_id", "sources", "derived_artifacts", "semantic_guards"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "ledger_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "derived_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "semantic_guards": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "required": ["id", "title", "url", "license", "retrieved_at", "sha256", "local_ref", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 120},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "url": {"type": "string", "format": "uri"},
        "license": {"type": "string", "minLength": 1, "maxLength": 160},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "sha256": {"$ref": "#/$defs/hash"},
        "local_ref": {"type": "string", "minLength": 1, "maxLength": 500},
        "role": {"enum": ["primary_data", "geography", "method", "context"]}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["ref", "sha256", "generator", "source_ids"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"$ref": "#/$defs/hash"},
        "generator": {"type": "string", "minLength": 1, "maxLength": 500},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}}
      },
      "additionalProperties": false
    }
  }
}
