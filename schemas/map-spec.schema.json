{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/map-spec.schema.json",
  "title": "MapSpec 0.2",
  "type": "object",
  "required": ["schema_version","projection","crs","extent","scale","layers"],
  "properties": {
    "schema_version": {"enum":["0.1.0","0.2.0"]},
    "projection": {"const":"equirectangular"},
    "crs": {"const":"EPSG:4326"},
    "task": {"enum":["world","continental","regional","local","site","trajectory","global_context","regional_route"]},
    "style_intent": {"const":"nature_scientific_map"},
    "basemap_id": {"type":"string","minLength":1},
    "basemap_asset": {"$ref":"#/$defs/basemapAsset"},
    "extent": {"$ref":"#/$defs/extent"},
    "scale": {
      "type":"object",
      "required":["enabled","unit"],
      "properties":{
        "enabled":{"const":true},
        "unit":{"const":"km"},
        "length_km":{"type":"number","exclusiveMinimum":0}
      },
      "additionalProperties":false
    },
    "graticule": {
      "type":"object",
      "properties":{
        "lon_step":{"type":"number","exclusiveMinimum":0},
        "lat_step":{"type":"number","exclusiveMinimum":0}
      },
      "additionalProperties":false
    },
    "layers": {"type":"array","minItems":1,"maxItems":20,"items":{"type":"object"}}
  },
  "allOf": [
    {
      "if": {"properties":{"schema_version":{"const":"0.1.0"}}},
      "then": {"required":["basemap_id"]}
    },
    {
      "if": {"properties":{"schema_version":{"const":"0.2.0"}}},
      "then": {
        "oneOf": [
          {"required":["basemap_id"],"not":{"required":["basemap_asset"]}},
          {"required":["basemap_asset"],"not":{"required":["basemap_id"]}}
        ]
      }
    }
  ],
  "$defs": {
    "extent": {
      "type":"object",
      "required":["west","east","south","north"],
      "properties":{
        "west":{"type":"number","minimum":-180,"maximum":180},
        "east":{"type":"number","minimum":-180,"maximum":180},
        "south":{"type":"number","minimum":-90,"maximum":90},
        "north":{"type":"number","minimum":-90,"maximum":90}
      },
      "additionalProperties":false
    },
    "basemapAsset": {
      "type":"object",
      "required":["content_hash","source_url","license","extent","detail_class","features"],
      "properties":{
        "schema_version":{"type":"string"},
        "id":{"type":["string","null"]},
        "content_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "source_url":{"type":"string","minLength":1},
        "license":{"type":"string","minLength":1},
        "extent":{"$ref":"#/$defs/extent"},
        "task":{"type":"string"},
        "detail_class":{"enum":["coarse","low","intermediate","high","full"]},
        "resolution_code":{"type":"string"},
        "nominal_scale":{"type":"string"},
        "features":{"type":"array","items":{"type":"object"}},
        "relief":{"type":["object","null"]}
      },
      "additionalProperties":true
    }
  },
  "additionalProperties": false
}
