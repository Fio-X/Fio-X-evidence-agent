{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-data-newsroom:schema:infographic-spec:1.5.0",
  "title": "Agentic Data Newsroom Infographic Spec v1.4",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "dek",
    "alt",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0",
        "1.4.0",
        "1.5.0"
      ]
    },
    "kicker": {
      "type": "string",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "dek": {
      "type": "string",
      "minLength": 1,
      "maxLength": 520
    },
    "alt": {
      "type": "string",
      "minLength": 30,
      "maxLength": 1600
    },
    "byline": {
      "type": "string",
      "maxLength": 120
    },
    "date_label": {
      "type": "string",
      "maxLength": 80
    },
    "layout": {
      "enum": [
        "feature",
        "poster",
        "briefing"
      ]
    },
    "complexity_budget": {
      "enum": [
        "low",
        "medium",
        "exploratory"
      ]
    },
    "source_note": {
      "type": "string",
      "maxLength": 1000
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "primary_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "story_arc": {
      "enum": [
        "explain",
        "compare",
        "chronology",
        "system",
        "question_answer",
        "profile"
      ]
    },
    "audience": {
      "enum": [
        "general",
        "informed",
        "specialist"
      ]
    },
    "quality_target": {
      "enum": [
        "publishable",
        "award"
      ]
    },
    "modules": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "competition_profile": {
      "enum": [
        "editorial",
        "snd47_infographics",
        "oja2026_visual",
        "sigma2026",
        "iib_awards"
      ]
    },
    "mobile_module_order": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Optional mobile-only reading order. Runtime validation requires an exact permutation of module ids."
    },
    "editorial_discovery_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "visual_concept_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "selected_concept_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "novelty_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "asset_plan_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "scene_graph": {
      "$ref": "#/$defs/sceneGraph"
    },
    "reader_question": {
      "type": "string",
      "minLength": 8,
      "maxLength": 320
    },
    "visual_thesis": {
      "type": "string",
      "minLength": 8,
      "maxLength": 420
    },
    "story_graph_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "editorial_grammar": {
      "$ref": "#/$defs/editorialGrammarSelection"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.1.0",
              "1.2.0",
              "1.3.0",
              "1.4.0",
              "1.5.0"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "intent",
          "primary_message",
          "story_arc",
          "audience",
          "quality_target"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.2.0",
              "1.3.0",
              "1.4.0",
              "1.5.0"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "competition_profile"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.3.0"
          },
          "quality_target": {
            "const": "award"
          }
        },
        "required": [
          "schema_version",
          "quality_target"
        ]
      },
      "then": {
        "required": [
          "editorial_discovery_ref",
          "visual_concept_ref",
          "selected_concept_id",
          "novelty_ref",
          "asset_plan_ref",
          "scene_graph"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.4.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "reader_question",
          "visual_thesis",
          "story_graph_ref",
          "editorial_discovery_ref",
          "visual_concept_ref",
          "selected_concept_id",
          "novelty_ref",
          "asset_plan_ref",
          "scene_graph"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.5.0"
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "reader_question",
          "visual_thesis",
          "story_graph_ref",
          "editorial_discovery_ref",
          "visual_concept_ref",
          "selected_concept_id",
          "novelty_ref",
          "asset_plan_ref",
          "scene_graph",
          "editorial_grammar"
        ],
        "properties": {
          "scene_graph": {
            "properties": {
              "schema_version": {"const": "0.2.0"}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "span": {
      "enum": [
        "full",
        "two_thirds",
        "half",
        "third"
      ]
    },
    "storyRole": {
      "enum": [
        "hook",
        "context",
        "evidence",
        "turn",
        "explanation",
        "resolution",
        "method"
      ]
    },
    "emphasis": {
      "enum": [
        "hero",
        "primary",
        "secondary",
        "support"
      ]
    },
    "annotation": {
      "type": "object",
      "required": ["id", "target_object_id", "text", "claim_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 100},
        "target_object_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "text": {"type": "string", "minLength": 1, "maxLength": 500},
        "claim_id": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "visualChannel": {
      "type": "object",
      "required": ["channel", "field", "role"],
      "properties": {
        "channel": {"enum": ["position", "length", "area", "size", "angle", "color", "opacity", "shape", "connection"]},
        "field": {"type": "string", "minLength": 1, "maxLength": 120},
        "role": {"enum": ["quantitative", "categorical", "identity", "emphasis", "uncertainty"]}
      },
      "additionalProperties": false
    },
    "quantitativeEncoding": {
      "type": "object",
      "required": ["quantity_kind", "mark_semantics", "scale_type", "baseline_policy", "uncertainty_disclosed"],
      "properties": {
        "quantity_kind": {"enum": ["observed_flow", "estimated_flow", "stock", "stock_change", "count", "rate", "share", "index", "other"]},
        "mark_semantics": {"enum": ["position", "length", "area", "size", "angle", "connection", "flow_width"]},
        "scale_type": {"enum": ["linear", "log", "sqrt", "symlog", "ordinal"]},
        "baseline_policy": {"enum": ["zero", "symmetric_zero", "included", "not_applicable"]},
        "domain_min": {"type": "number"},
        "domain_max": {"type": "number"},
        "area_proportional": {"type": "boolean"},
        "uncertainty_disclosed": {"type": "boolean"},
        "disclosure": {"type": "string", "maxLength": 500}
      },
      "additionalProperties": false
    },
    "sceneBudget": {
      "type": "object",
      "required": ["max_supporting_objects", "max_annotations", "max_claims"],
      "properties": {
        "max_supporting_objects": {"type": "integer", "minimum": 0, "maximum": 3},
        "max_annotations": {"type": "integer", "minimum": 0, "maximum": 8},
        "max_claims": {"type": "integer", "minimum": 1, "maximum": 12}
      },
      "additionalProperties": false
    },
    "editorialGrammarSelection": {
      "type": "object",
      "required": ["schema_version", "project_id", "primary", "supporting", "available_renderer_capabilities", "evidence_features", "cognitive_goals", "candidates", "selected", "decision_log"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "primary": {"$ref": "#/$defs/editorialGrammar"},
        "supporting": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/editorialGrammar"}},
        "available_renderer_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["svg", "canvas2d", "webgl_map"]}},
        "evidence_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
        "cognitive_goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ORIENT", "ZOOM", "EXPLAIN", "MEASURE", "COMPARE", "CONSEQUENCE"]}},
        "candidates": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/editorialGrammarCandidate"}},
        "selected": {"$ref": "#/$defs/editorialGrammar"},
        "decision_log": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/editorialGrammarDecision"}}
      },
      "additionalProperties": false
    },
    "editorialGrammar": {"enum": ["CUTAWAY", "SCALE_TRANSLATOR", "MECHANISM_FLOW", "SPECIMEN_GRID", "THEN_NOW", "ROUTE_SPINE"]},
    "editorialGrammarCandidate": {
      "type": "object",
      "required": ["grammar", "hard_constraints_passed", "renderer_capability_passed", "soft_score", "reason_codes"],
      "properties": {
        "grammar": {"$ref": "#/$defs/editorialGrammar"},
        "hard_constraints_passed": {"type": "boolean"},
        "renderer_capability_passed": {"type": "boolean"},
        "soft_score": {"type": "number", "minimum": 0, "maximum": 1},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}}
      },
      "additionalProperties": false
    },
    "editorialGrammarDecision": {
      "type": "object",
      "required": ["stage", "grammar", "outcome", "reason_code"],
      "properties": {
        "stage": {"enum": ["hard_constraint", "soft_preference", "renderer_capability", "final_selection"]},
        "grammar": {"$ref": "#/$defs/editorialGrammar"},
        "outcome": {"enum": ["pass", "reject", "select"]},
        "reason_code": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "baseModule": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "enum": [
            "hero_stat",
            "visual",
            "illustration",
            "text",
            "section_header",
            "pull_quote"
          ]
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "tone": {
          "enum": [
            "accent",
            "dark",
            "light"
          ]
        },
        "story_role": {
          "$ref": "#/$defs/storyRole"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "emphasis": {
          "$ref": "#/$defs/emphasis"
        },
        "reader_question_id": {
          "type": "string",
          "maxLength": 100
        },
        "claim_set": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 20
        },
        "new_information": {
          "type": "string",
          "maxLength": 500
        },
        "explanatory_dimension": {
          "enum": [
            "trend",
            "rank",
            "spatial",
            "mechanism",
            "comparison",
            "distribution",
            "uncertainty",
            "human_scale",
            "method",
            "context",
            "outcome"
          ]
        },
        "dependency_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 12
        },
        "story_node_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "visual_grammar": {
          "enum": [
            "rank",
            "change",
            "trend",
            "anomaly",
            "benchmark",
            "composition",
            "distribution",
            "relationship",
            "uncertainty",
            "flow",
            "spatial",
            "network",
            "mechanism",
            "sequence"
          ]
        },
        "graphic_object_ids": {
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "annotations": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/annotation"}
        },
        "visual_channels": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/$defs/visualChannel"}
        },
        "quantitative_encoding": {
          "$ref": "#/$defs/quantitativeEncoding"
        }
      }
    },
    "module": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseModule"
            },
            {
              "properties": {
                "type": {
                  "const": "hero_stat"
                },
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "unit": {
                  "type": "string",
                  "maxLength": 40
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "detail": {
                  "type": "string",
                  "maxLength": 240
                },
                "claim_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "value",
                "label",
                "claim_id"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseModule"
            },
            {
              "properties": {
                "type": {
                  "const": "visual"
                },
                "manifest_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "caption": {
                  "type": "string",
                  "maxLength": 300
                },
                "critic_ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "manifest_ref"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseModule"
            },
            {
              "properties": {
                "type": {
                  "const": "illustration"
                },
                "asset_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "alt": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 1200
                },
                "credit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "caption": {
                  "type": "string",
                  "maxLength": 320
                },
                "claim_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "asset_ref",
                "alt",
                "credit",
                "claim_ids"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseModule"
            },
            {
              "properties": {
                "type": {
                  "const": "text"
                },
                "heading": {
                  "type": "string",
                  "maxLength": 180
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1400
                },
                "claim_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "body",
                "claim_ids"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseModule"
            },
            {
              "properties": {
                "type": {
                  "const": "section_header"
                },
                "eyebrow": {
                  "type": "string",
                  "maxLength": 80
                },
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "deck": {
                  "type": "string",
                  "maxLength": 320
                }
              },
              "required": [
                "heading"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseModule"
            },
            {
              "properties": {
                "type": {
                  "const": "pull_quote"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 360
                },
                "attribution": {
                  "type": "string",
                  "maxLength": 160
                },
                "claim_ids": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "text"
              ]
            }
          ]
        }
      ]
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "pattern",
        "anchor_module_id",
        "sidecar_module_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "pattern": {
          "enum": [
            "hero_sidecar_stack",
            "hero_with_rail"
          ]
        },
        "eyebrow": {
          "type": "string",
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "maxLength": 180
        },
        "dek": {
          "type": "string",
          "maxLength": 360
        },
        "anchor_module_id": {
          "type": "string",
          "minLength": 1
        },
        "sidecar_module_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shared_source_scope": {
          "type": "boolean"
        },
        "primary_cognitive_goal": {
          "enum": ["ORIENT", "ZOOM", "EXPLAIN", "MEASURE", "COMPARE", "CONSEQUENCE"]
        },
        "hero_object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "supporting_claim_ids": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "scene_budget": {
          "$ref": "#/$defs/sceneBudget"
        }
      },
      "additionalProperties": false
    },
    "sceneGraph": {
      "type": "object",
      "required": [
        "schema_version",
        "scenes"
      ],
      "properties": {
        "schema_version": {"enum": ["0.1.0", "0.2.0"]},
        "scenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/scene"
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"schema_version": {"const": "0.1.0"}}, "required": ["schema_version"]},
          "then": {"properties": {"scenes": {"maxItems": 3}}}
        },
        {
          "if": {"properties": {"schema_version": {"const": "0.2.0"}}, "required": ["schema_version"]},
          "then": {
            "properties": {
              "scenes": {
                "items": {
                  "required": ["id", "pattern", "anchor_module_id", "sidecar_module_ids", "primary_cognitive_goal", "hero_object_id", "supporting_claim_ids", "scene_budget"]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
