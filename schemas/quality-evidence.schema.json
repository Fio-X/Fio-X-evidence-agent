  "hard_gates":{"type":"array","items":{"type":"object","required":["id","passed"],"properties":{"id":{"type":"string"},"passed":{"type":"boolean"},"evidence_ref":{"type":"string"}},"additionalProperties":true}},
  "diagnostics":{"type":"array","items":{"type":"object"}},
