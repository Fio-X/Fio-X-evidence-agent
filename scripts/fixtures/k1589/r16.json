{
 "tool": "newsroom_design_pack",
 "schema": {
  "properties": {
   "asset_requirements": {
    "description": "Parameters of newsroom_asset_requirements except concept_ref (concept_id defaults to the selected concept).",
    "properties": {
     "concept_id": {
      "type": "string"
     },
     "requirements": {
      "items": {
       "properties": {
        "asset_class": {
         "enum": [
          "published_gis",
          "archival_photo",
          "verified_diagram",
          "portrait_or_object_photo",
          "expert_explanation",
          "geographic_coordinates",
          "historical_series",
          "human_scale_reference",
          "vector_illustration",
          "verified_3d"
         ],
         "type": "string"
        },
        "available": {
         "type": "boolean"
        },
        "evidence_needed": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "production_lane": {
         "enum": [
          "software_schematic",
          "human_vector",
          "human_illustration",
          "gis_render",
          "photo_collage",
          "verified_3d",
          "generated_disclosed"
         ],
         "type": "string"
        },
        "purpose": {
         "type": "string"
        },
        "rejection_reason": {
         "type": "string"
        },
        "source_refs": {
         "items": {
          "type": "string"
         },
         "maxItems": 20,
         "type": "array"
        },
        "status": {
         "enum": [
          "blocking",
          "required",
          "optional"
         ],
         "type": "string"
        }
       },
       "required": [
        "asset_class",
        "status",
        "available",
        "purpose"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "requirements"
    ],
    "type": "object"
   },
   "basemap": {
    "description": "Optional: parameters of newsroom_basemap_prepare."
   },
   "charts": {
    "description": "One newsroom_viz_plan judgement per chart."
   },
   "discovery": {
    "description": "Parameters of newsroom_editorial_discovery.",
    "properties": {
     "candidate_questions": {
      "items": {
       "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array"
     },
     "counterintuitive_findings": {
      "items": {
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "human_scale_refs": {
      "items": {
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "kill_reasons": {
      "items": {
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "mechanisms": {
      "items": {
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "missing_reporting": {
      "items": {
       "properties": {
        "blocking": {
         "type": "boolean"
        },
        "need": {
         "type": "string"
        },
        "reason": {
         "type": "string"
        }
       },
       "required": [
        "need",
        "blocking"
       ],
       "type": "object"
      },
      "maxItems": 12,
      "type": "array"
     },
     "reader_problem": {
      "type": "string"
     },
     "spatial_dimensions": {
      "items": {
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "surprises": {
      "items": {
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "temporal_dimensions": {
      "items": {
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "uncertainties": {
      "items": {
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     }
    },
    "required": [
     "reader_problem",
     "candidate_questions",
     "surprises",
     "counterintuitive_findings",
     "human_scale_refs",
     "spatial_dimensions",
     "temporal_dimensions",
     "mechanisms",
     "uncertainties",
     "missing_reporting",
     "kill_reasons"
    ],
    "type": "object"
   },
   "needs_compute": {
    "description": "Optional list of claims or results still to record; the pack stops before any chart and reports them."
   },
   "page": {
    "description": "The newsroom_infographic_plan judgement; a visual module names its chart by index (chart: i)."
   },
   "part": {
    "description": "first = discovery, story graph, concepts, novelty and assets only; second = the rest; omit for both. Each half counts as one send of the judgement pack (three sends in all), so after both halves one send is left for a correction.",
    "type": "string"
   },
   "publication": {
    "description": "style_profile and, by module id, the allowed publication module fields."
   },
   "reference_patterns": {
    "description": "Optional: parameters of newsroom_reference_patterns."
   },
   "revise": {
    "description": "Map of a drafted field path to \"=\" (keep) or new text."
   },
   "semantic_novelty": {
    "description": "Parameters of newsroom_semantic_novelty except concept_ref.",
    "properties": {
     "modules": {
      "items": {
       "properties": {
        "claim_set": {
         "items": {
          "type": "string"
         },
         "maxItems": 20,
         "minItems": 1,
         "type": "array"
        },
        "dependency_on": {
         "items": {
          "type": "string"
         },
         "maxItems": 12,
         "type": "array"
        },
        "explanatory_dimension": {
         "enum": [
          "trend",
          "rank",
          "spatial",
          "mechanism",
          "comparison",
          "distribution",
          "uncertainty",
          "human_scale",
          "method",
          "context",
          "outcome",
          "relationship"
         ],
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "justification": {
         "type": "string"
        },
        "new_information": {
         "type": "string"
        },
        "reader_question_id": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "reader_question_id",
        "claim_set",
        "new_information",
        "explanatory_dimension"
       ],
       "type": "object"
      },
      "maxItems": 30,
      "minItems": 2,
      "type": "array"
     }
    },
    "required": [
     "modules"
    ],
    "type": "object"
   },
   "story_graph": {
    "description": "Parameters of newsroom_story_graph.",
    "properties": {
     "answer_node_ids": {
