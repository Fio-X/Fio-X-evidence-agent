         "items": {
          "type": "string"
         },
         "maxItems": 20,
         "type": "array"
        },
        "explanatory_dimension": {
         "enum": [
          "trend",
          "rank",
          "spatial",
          "mechanism",
          "comparison",
          "distribution",
          "uncertainty",
          "human_scale",
          "method",
          "context",
          "outcome",
          "relationship"
         ],
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "kind": {
         "enum": [
          "evidence",
          "claim",
          "mechanism",
          "context",
          "outcome",
          "uncertainty"
