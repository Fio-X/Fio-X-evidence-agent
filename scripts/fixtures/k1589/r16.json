        "note": {
         "type": "string"
        },
        "relation": {
         "enum": [
          "supports",
          "causes",
          "contributes_to",
          "explains",
          "contrasts_with",
          "qualifies",
          "locates",
          "precedes",
          "benchmarks"
         ],
         "type": "string"
        },
        "to": {
         "type": "string"
        }
       },
       "required": [
        "from",
        "to",
        "relation"
       ],
       "type": "object"
      },
      "maxItems": 48,
      "minItems": 2,
      "type": "array"
     },
     "entry_node_ids": {
      "items": {
       "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array"
     },
     "nodes": {
      "items": {
       "properties": {
