        "summary": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "kind",
        "summary",
        "explanatory_dimension"
       ],
       "type": "object"
      },
      "maxItems": 24,
      "minItems": 3,
      "type": "array"
     },
     "reader_question": {
      "type": "string"
     },
     "story_id": {
      "type": "string"
     },
     "visual_thesis": {
      "type": "string"
     }
    },
    "required": [
